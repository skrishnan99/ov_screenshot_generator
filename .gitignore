# Secrets — never version
.env
.env.*
*.pem
*.key

# Run outputs (screenshots, downloads, descriptions, manifests) — generated per run
runs/

# Ad-hoc report bundles produced by pipeline.py --out. These are deliverables,
# not source: one of them (85 MB) was tracked by accident and shipped to every
# plugin install.
test_report_*/

# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Tool caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# OS noise
.DS_Store
deck_outputs/

# Google OAuth. The per-user token is a real credential — never version it.
# The bundled OAuth *client* (publish/google_client.json) is deliberately NOT
# ignored: for desktop apps Google treats it as a non-confidential app
# identifier, and committing it to the PRIVATE marketplace repo is what lets
# engineers install the plugin and publish with zero setup.
google_token.json
/google_client.json

google_library.json
